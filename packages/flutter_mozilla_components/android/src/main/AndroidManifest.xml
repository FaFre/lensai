<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="eu.weblibre.flutter_mozilla_components">
  <application>
    <!-- Starts tracking activities before the first one resumes, so extension
         install prompts have a host no matter which app embeds this plugin.
         See WebExtensionPromptInitializer. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="eu.weblibre.flutter_mozilla_components.addons.WebExtensionPromptInitializer"
        android:value="androidx.startup" />
    </provider>
  </application>
</manifest>
